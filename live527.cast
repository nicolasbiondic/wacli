{"version": 2, "width": 160, "height": 46, "timestamp": 1792868521, "env": {"SHELL": "/bin/bash", "TERM": "xterm-256color"}}
[0.005335, "o", "== 1. Latest stable daemon (v0.25.0) owns the store; the patched CLI explains the upgrade\r\n"]
[4.104449, "o", "\r\n"]
[4.107143, "o", "$ wacli-0.25.0 --store STORE sync --follow   # running\r\n"]
[4.107694, "o", "\r\n"]
[4.110655, "o", "$ wacli-527 --store STORE profile picture-info --jid PEER\r\n"]
[4.123678, "o", "the running sync process does not support profile picture-info; restart `wacli sync` after upgrading, then run this again: unsupported send kind \"profile_picture_info\"\r\n"]
[4.124572, "o", "\r\n"]
[4.127457, "o", "$ wacli-0.25.0 --store STORE profile picture-info --jid PEER   # the stock CLI, for comparison\r\n"]
[4.137339, "o", "store is locked (another wacli is running?): store locked: resource temporarily unavailable (pid=2745342 acquired_at=REDACTEDT14:02:01.REDACTED:00)\r\n"]
[5.217887, "o", "\r\n== 2. Patched daemon owns the store; lookups are answered on its live connection\r\n"]
[9.235284, "o", "\r\n"]
[9.238567, "o", "$ wacli-527 --store STORE sync --follow   # running\r\n"]
[9.239321, "o", "\r\n"]
[9.242542, "o", "$ wacli-527 --store STORE profile picture-info --jid OWN   # the linked account, text output\r\n"]
[9.430173, "o", "JID: REDACTED\r\nID: REDACTED\r\nType: image\r\n"]
[9.430432, "o", "URL: REDACTED-URL\r\n"]
[9.430577, "o", "Direct path: REDACTED\r\n"]
[9.43146, "o", "\r\n"]
[9.43432, "o", "$ wacli-527 --store STORE --json profile picture-info --jid PEER\r\n"]
[9.584771, "o", "{\"success\":true,\"data\":{\"jid\":\"REDACTED@s.whatsapp.net\",\"id\":\"REDACTED\",\"url\":\"REDACTED-URL\",\"type\":\"image\",\"direct_path\":\"REDACTED\",\"hash\":\"REDACTED\"},\"error\":null}\r\n"]
[9.666771, "o", "\r\n"]
[9.669925, "o", "$ wacli-527 --store STORE --json profile picture-info --jid PEER --existing-id ID   # same picture\r\n"]
[9.813907, "o", "{\"success\":true,\"data\":{\"jid\":\"REDACTED@s.whatsapp.net\",\"unchanged\":true},\"error\":null}\r\n"]
[9.815037, "o", "\r\n"]
[9.817726, "o", "$ wacli-527 --store STORE --json profile picture-info --jid status@broadcast\r\n"]
[9.828299, "o", "{\"success\":false,\"data\":null,\"error\":\"get profile picture info: jid must identify a user or group\"}\r\n"]
[11.083965, "o", "\r\n== 3. Same lookup without a daemon (direct connection): identical result\r\n\r\n"]
[11.086642, "o", "$ wacli-527 --store STORE --json profile picture-info --jid PEER   # nothing running\r\n"]
[13.183283, "o", "{\"success\":true,\"data\":{\"jid\":\"REDACTED@s.whatsapp.net\",\"id\":\"REDACTED\",\"url\":\"REDACTED-URL\",\"type\":\"image\",\"direct_path\":\"REDACTED\",\"hash\":\"REDACTED\"},\"error\":null}\r\n"]
[13.293447, "o", "delegated == direct: True\r\n"]
