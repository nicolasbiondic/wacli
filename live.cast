[0.016342, "o", "0.25.0\r\n"]
[0.016711, "o", "\r\n"]
[0.019149, "o", "$ wacli-528 --read-only messages list --chat CHAT --limit 4 --json   # a poll from another phone, then a vote, a contact card and an event sent from the primary\r\n"]
