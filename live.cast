[0.52277, "o", "\r\n== Purge: the kind goes with the payload\r\n\r\n"]
[0.52552, "o", "$ # stop sync --follow: delete --for-me and purge take the store lock\r\n"]
[1.604657, "o", "\r\n"]
[1.607161, "o", "$ wacli-528 messages delete --for-me --chat CHAT --id 2A6663295B826F14514B\r\n"]
[6.041251, "o", "Deleted message 2A6663295B826F14514B for me in REDACTED@s.whatsapp.net\r\n"]
[9.04421, "o", "\r\n"]
